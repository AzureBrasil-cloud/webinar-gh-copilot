<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Book Store</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookStore.Web.Web.styles.css" asp-append-version="true" />
</head>
<body class="h-screen overflow-hidden bg-surface-0">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    }
    <div class="flex h-full w-full gap-3 p-4">
        <div
            id="sidebar-app"
            data-active="@currentController"
            data-home-url="@Url.Action("Index", "Home")"
            data-books-url="@Url.Action("Index", "Books")"
            data-authors-url="@Url.Action("Index", "Authors")"
            data-customers-url="@Url.Action("Index", "Customers")"
        ></div>
        <div class="flex h-full min-w-0 flex-1 flex-col">
            <main role="main" class="flex-1 overflow-y-auto">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
