@using BookStore.Application.Common
@model dynamic

@{
    var pageNumber = (int)Model.PageNumber;
    var totalPages = (int)Model.TotalPages;
    var totalItems = (int)Model.TotalItems;
    var hasPrevious = (bool)Model.HasPrevious;
    var hasNext = (bool)Model.HasNext;
}

<nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination justify-content-center align-items-center">
        <li class="page-item @(!hasPrevious ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber - 1)">Previous</a>
        </li>
        <li class="page-item disabled">
            <span class="page-link">Page @pageNumber of @totalPages — @totalItems items</span>
        </li>
        <li class="page-item @(!hasNext ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber + 1)">Next</a>
        </li>
    </ul>
</nav>
