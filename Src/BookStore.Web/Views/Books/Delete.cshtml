@model Book
@{
    ViewData["Title"] = "Delete book";
}

<h1 class="text-2xl font-semibold text-red-600 mb-3">Delete book</h1>
<p class="mb-3">Are you sure you want to delete this book?</p>

<dl class="grid grid-cols-12 gap-y-2 mb-4">
    <dt class="col-span-3 font-medium text-color">Title</dt>
    <dd class="col-span-9">@Model.Title</dd>

    <dt class="col-span-3 font-medium text-color">Author</dt>
    <dd class="col-span-9">@Model.Author?.Name</dd>

    <dt class="col-span-3 font-medium text-color">Price</dt>
    <dd class="col-span-9">@Model.Price.ToString("C")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
