@model Book
@{
    ViewData["Title"] = "Book details";
}

<h1 class="h3 mb-3">@Model.Title</h1>

<dl class="row">
    <dt class="col-sm-3">Author</dt>
    <dd class="col-sm-9">@Model.Author?.Name</dd>

    <dt class="col-sm-3">Genre</dt>
    <dd class="col-sm-9">@Model.Genre</dd>

    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.Isbn</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

    <dt class="col-sm-3">Stock</dt>
    <dd class="col-sm-9">@Model.Stock</dd>

    <dt class="col-sm-3">Number of pages</dt>
    <dd class="col-sm-9">@Model.NumberOfPages</dd>

    <dt class="col-sm-3">Available</dt>
    <dd class="col-sm-9">@(Model.IsAvailable ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Published</dt>
    <dd class="col-sm-9">@Model.PublishedDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Back</a>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
