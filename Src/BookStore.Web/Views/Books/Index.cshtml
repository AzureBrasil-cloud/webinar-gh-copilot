@model IEnumerable<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Books</h1>
    <a asp-action="Create" class="btn btn-primary">New book</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th class="text-end">Price</th>
                <th class="text-end">Stock</th>
                <th>Available</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author?.Name</td>
                <td>@book.Genre</td>
                <td class="text-end">@book.Price.ToString("C")</td>
                <td class="text-end">@book.Stock</td>
                <td>
                    @if (book.IsAvailable)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@book.Id">Details</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@book.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
