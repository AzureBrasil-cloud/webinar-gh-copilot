@using BookStore.Application.Common
@model PagedResult<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Books</h1>
    <a asp-action="Create" class="btn btn-primary">New book</a>
</div>

<div id="books-app"
     data-api-url="/api/books"
     data-details-url="@Url.Action("Details", "Books")"
     data-edit-url="@Url.Action("Edit", "Books")"
     data-delete-url="@Url.Action("Delete", "Books")"></div>

@section Scripts {
    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true" />
    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
}
