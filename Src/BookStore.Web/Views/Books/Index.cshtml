@using BookStore.Application.Common
@model PagedResult<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="flex items-center justify-between mb-3">
    <h1 class="text-2xl font-semibold text-color">Books</h1>
    <a asp-action="Create" class="btn btn-primary">New book</a>
</div>

<div id="books-app"
     data-api-url="/api/books"
     data-details-url="@Url.Action("Details", "Books")"
     data-edit-url="@Url.Action("Edit", "Books")"
     data-delete-url="@Url.Action("Delete", "Books")"></div>
