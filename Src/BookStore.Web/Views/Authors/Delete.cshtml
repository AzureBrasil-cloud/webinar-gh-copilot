@model Author
@{
    ViewData["Title"] = "Delete author";
}

<h1 class="text-2xl font-semibold text-red-600 mb-3">Delete author</h1>
<div asp-validation-summary="ModelOnly" class="alert-danger mb-3"></div>
<p class="mb-3">Are you sure you want to delete this author?</p>

<dl class="grid grid-cols-12 gap-y-2 mb-4">
    <dt class="col-span-3 font-medium text-color">Name</dt>
    <dd class="col-span-9">@Model.Name</dd>

    <dt class="col-span-3 font-medium text-color">Nationality</dt>
    <dd class="col-span-9">@Model.Nationality</dd>

    <dt class="col-span-3 font-medium text-color">Books</dt>
    <dd class="col-span-9">@Model.Books.Count</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
