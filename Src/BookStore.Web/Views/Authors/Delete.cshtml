@model Author
@{
    ViewData["Title"] = "Delete author";
}

<h1 class="h3 mb-3 text-danger">Delete author</h1>
<div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-empty"></div>
<p>Are you sure you want to delete this author?</p>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Nationality</dt>
    <dd class="col-sm-9">@Model.Nationality</dd>

    <dt class="col-sm-3">Books</dt>
    <dd class="col-sm-9">@Model.Books.Count</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
