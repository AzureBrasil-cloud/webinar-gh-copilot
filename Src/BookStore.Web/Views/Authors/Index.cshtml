@using BookStore.Application.Common
@model PagedResult<Author>
@{
    ViewData["Title"] = "Authors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Authors</h1>
    <a asp-action="Create" class="btn btn-primary">New author</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Nationality</th>
                <th>Birth date</th>
                <th class="text-end">Books</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var author in Model.Items)
        {
            <tr>
                <td>@author.Name</td>
                <td>@author.Age</td>
                <td>@author.Nationality</td>
                <td>@author.BirthDate.ToString("yyyy-MM-dd")</td>
                <td class="text-end">@author.Books.Count</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@author.Id">Details</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@author.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@author.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
