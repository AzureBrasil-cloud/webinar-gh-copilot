@model Author
@{
    ViewData["Title"] = "New author";
}

<h1 class="h3 mb-3">New author</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-empty"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Nationality" class="form-label"></label>
            <input asp-for="Nationality" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="BirthDate" class="form-label">Birth date</label>
            <input asp-for="BirthDate" type="date" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Bio" class="form-label"></label>
            <textarea asp-for="Bio" rows="4" class="form-control"></textarea>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
