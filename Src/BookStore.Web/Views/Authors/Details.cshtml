@model Author
@{
    ViewData["Title"] = "Author details";
}

<h1 class="text-2xl font-semibold text-color mb-3">@Model.Name</h1>

<dl class="grid grid-cols-12 gap-y-2 mb-4">
    <dt class="col-span-3 font-medium text-color">Nationality</dt>
    <dd class="col-span-9">@Model.Nationality</dd>

    <dt class="col-span-3 font-medium text-color">Age</dt>
    <dd class="col-span-9">@Model.Age</dd>

    <dt class="col-span-3 font-medium text-color">Birth date</dt>
    <dd class="col-span-9">@Model.BirthDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-span-3 font-medium text-color">Bio</dt>
    <dd class="col-span-9">@Model.Bio</dd>
</dl>

<h2 class="text-xl font-medium text-color mt-4 mb-2">Books</h2>
@if (Model.Books.Any())
{
    <ul class="list-disc pl-5">
        @foreach (var book in Model.Books)
        {
            <li>@book.Title <span class="text-muted-color">(@book.PublishedDate.Year)</span></li>
        }
    </ul>
}
else
{
    <p class="text-muted-color">No books registered for this author.</p>
}

<a class="btn btn-secondary" asp-action="Index">Back</a>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
