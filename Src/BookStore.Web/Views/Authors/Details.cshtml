@model Author
@{
    ViewData["Title"] = "Author details";
}

<h1 class="h3 mb-3">@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-3">Nationality</dt>
    <dd class="col-sm-9">@Model.Nationality</dd>

    <dt class="col-sm-3">Birth date</dt>
    <dd class="col-sm-9">@Model.BirthDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Bio</dt>
    <dd class="col-sm-9">@Model.Bio</dd>
</dl>

<h2 class="h5 mt-4">Books</h2>
@if (Model.Books.Any())
{
    <ul>
        @foreach (var book in Model.Books)
        {
            <li>@book.Title <span class="text-muted">(@book.PublishedDate.Year)</span></li>
        }
    </ul>
}
else
{
    <p class="text-muted">No books registered for this author.</p>
}

<a class="btn btn-secondary" asp-action="Index">Back</a>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
