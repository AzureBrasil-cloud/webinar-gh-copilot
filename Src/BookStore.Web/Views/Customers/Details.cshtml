@model Customer
@{
    ViewData["Title"] = "Customer details";
}

<h1 class="text-2xl font-semibold text-color mb-3">@Model.FullName</h1>

<dl class="grid grid-cols-12 gap-y-2 mb-4">
    <dt class="col-span-3 font-medium text-color">Email</dt>
    <dd class="col-span-9">@Model.Email</dd>

    <dt class="col-span-3 font-medium text-color">Phone number</dt>
    <dd class="col-span-9">@Model.PhoneNumber</dd>

    <dt class="col-span-3 font-medium text-color">Created at</dt>
    <dd class="col-span-9">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Back</a>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
