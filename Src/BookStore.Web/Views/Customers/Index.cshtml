@using BookStore.Application.Common
@model PagedResult<Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customers</h1>
    <a asp-action="Create" class="btn btn-primary">New customer</a>
</div>

<div id="customers-app"
     data-api-url="/api/customers"
     data-details-url="@Url.Action("Details", "Customers")"
     data-edit-url="@Url.Action("Edit", "Customers")"
     data-delete-url="@Url.Action("Delete", "Customers")"></div>

@section Scripts {
    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true" />
    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
}
